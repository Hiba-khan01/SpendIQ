# SpendIQ Environment Configuration

# MySQL Database Connection URL
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/spendiq

# JWT Authentication
JWT_SECRET=spendiq-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional AI / LLM Provider Key (Gemini / OpenAI)
AI_API_KEY=
AI_PROVIDER=auto

# Default Currency (INR, USD, EUR, GBP, etc.)
DEFAULT_CURRENCY=INR
