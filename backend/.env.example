# SpendIQ Backend Environment Configuration

# Database: MySQL (or sqlite:///./spendiq.db fallback)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/spendiq

# JWT Authentication
JWT_SECRET=spendiq-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional AI / LLM Provider Key (Gemini / OpenAI)
AI_API_KEY=
AI_PROVIDER=auto

# Default Currency
DEFAULT_CURRENCY=INR
